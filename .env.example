# Environment Configuration Example
# Do NOT place actual production secrets in this file.

# Backend Settings
ENVIRONMENT=development
PORT=8000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=symbio_db

# Firebase Authentication (Backend Admin SDK & Frontend)
# Note: For the backend Admin SDK, you typically use a service account JSON file,
# but for frontend initialization, you'll need these public keys.
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Path to your service account JSON file)
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json

# Twilio API
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number

# AI Model Provider (e.g., HuggingFace, Local LLM)
AI_MODEL_PROVIDER_URL=http://localhost:11434/api/generate
AI_MODEL_API_KEY=optional_api_key
